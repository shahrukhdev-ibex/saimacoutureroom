# Copy to .env.local and fill in. Everything here is optional — src/lib/site.ts
# has defaults — but these override it without editing source.

NEXT_PUBLIC_SITE_URL=https://saimascoutureroom.com

# Digits only, with country code, no "+"
NEXT_PUBLIC_WHATSAPP=923000000000

# The same number, formatted for a human to read
NEXT_PUBLIC_PHONE_DISPLAY=+92 300 000 0000

# The same number for structured data
NEXT_PUBLIC_PHONE_SCHEMA=+92-300-000-0000

NEXT_PUBLIC_EMAIL=hello@saimascoutureroom.com
